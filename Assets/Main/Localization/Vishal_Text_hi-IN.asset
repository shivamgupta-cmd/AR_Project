  - m_Id: 34505766907465728
    m_Localized: "\u091A\u092F\u0928 \u0915\u0930\u0947\u0902"
    m_Metadata:
      m_Items: []
  - m_Id: 34506886056824832
    m_Localized: "\u092E\u0947\u0928\u0942\r"
    m_Metadata:
      m_Items: []
  - m_Id: 34513239445917696
    m_Localized: "\u092E\u094D\u092F\u0942\u091F"
    m_Metadata:
      m_Items: []
  - m_Id: 34513633156845568
    m_Localized: "\r\u0905\u0928\u092E\u094D\u092F\u0942\u091F"
    m_Metadata:
      m_Items: []
  - m_Id: 34537983725588480
    m_Localized: "\u092F\u0939 \u090F\u0906\u0930 \u092A\u0930\u093F\u092F\u094B\u091C\u0928\u093E
      \u0935\u093F\u091C\u094D\u091E\u093E\u0928 \u0915\u094B \u091C\u0940\u0935\u0902\u0924
      \u092C\u0928\u093E\u0924\u0940 \u0939\u0948, \u091C\u093F\u0938\u092E\u0947\u0902
      \u091C\u0940\u0935\u0935\u093F\u091C\u094D\u091E\u093E\u0928, \u0930\u0938\u093E\u092F\u0928
      \u0935\u093F\u091C\u094D\u091E\u093E\u0928 \u0914\u0930 \u092D\u094C\u0924\u093F\u0915\u0940
      \u0938\u0947 \u091C\u0941\u0921\u093C\u0947 100 \u0938\u0947 \u0905\u0927\u093F\u0915
      \u0907\u0902\u091F\u0930\u090F\u0915\u094D\u091F\u093F\u0935 \u092E\u0949\u0921\u094D\u092F\u0942\u0932
      \u0936\u093E\u092E\u093F\u0932 \u0939\u0948\u0902\u0964 \u092A\u094D\u0930\u0924\u094D\u092F\u0947\u0915
      \u092E\u0949\u0921\u094D\u092F\u0942\u0932 \u091C\u091F\u093F\u0932 \u0905\u0935\u0927\u093E\u0930\u0923\u093E\u0913\u0902
      \u0915\u094B \u0911\u0917\u092E\u0947\u0902\u091F\u0947\u0921 \u0930\u093F\u092F\u0932\u093F\u091F\u0940
      \u0915\u0947 \u092E\u093E\u0927\u094D\u092F\u092E \u0938\u0947 \u0926\u0930\u094D\u0936\u093E\u0924\u093E
      \u0939\u0948, \u091C\u093F\u0938\u0938\u0947 \u0938\u0940\u0916\u0928\u093E
      \u0905\u0927\u093F\u0915 \u0906\u0915\u0930\u094D\u0937\u0915, \u0930\u094B\u091A\u0915
      \u0914\u0930 \u0907\u0902\u091F\u0930\u090F\u0915\u094D\u091F\u093F\u0935 \u0939\u094B
      \u091C\u093E\u0924\u093E \u0939\u0948\u0964 \u092F\u0939 \u092A\u0930\u093F\u092F\u094B\u091C\u0928\u093E
      \u091B\u093E\u0924\u094D\u0930\u094B\u0902 \u0914\u0930 \u0936\u093F\u0915\u094D\u0937\u0915\u094B\u0902
      \u0915\u0947 \u0932\u093F\u090F \u0935\u093F\u0936\u0947\u0937 \u0930\u0942\u092A
      \u0938\u0947 \u0924\u0948\u092F\u093E\u0930 \u0915\u0940 \u0917\u0908 \u0939\u0948,
      \u091C\u094B 3D \u092E\u0949\u0921\u0932, \u090F\u0928\u0940\u092E\u0947\u0936\u0928
      \u0914\u0930 \u0907\u0902\u091F\u0930\u090F\u0915\u094D\u091F\u093F\u0935 \u0924\u0924\u094D\u0935\u094B\u0902
      \u0915\u0947 \u092E\u093E\u0927\u094D\u092F\u092E \u0938\u0947 \u0935\u093F\u091C\u094D\u091E\u093E\u0928
      \u0915\u094B \u0938\u0930\u0932 \u0914\u0930 \u0938\u092E\u091D\u0928\u0947
      \u092F\u094B\u0917\u094D\u092F \u092C\u0928\u093E\u0924\u0940 \u0939\u0948\u0964
      \u092F\u0939 \u091C\u093F\u091C\u094D\u091E\u093E\u0938\u093E \u0915\u094B
      \u092C\u0922\u093C\u093E\u0935\u093E \u0926\u0947\u0924\u0940 \u0939\u0948,
      \u0938\u092E\u091D \u0915\u094B \u092E\u091C\u092C\u0942\u0924 \u0915\u0930\u0924\u0940
      \u0939\u0948 \u0914\u0930 \u0926\u0943\u0936\u094D\u092F \u0906\u0927\u093E\u0930\u093F\u0924
      \u0938\u0940\u0916\u0928\u0947 \u0915\u094B \u0938\u092E\u0930\u094D\u0925\u0928
      \u0926\u0947\u0924\u0940 \u0939\u0948\u0964 \u0909\u092A\u092F\u094B\u0917\u0915\u0930\u094D\u0924\u093E\u0913\u0902
      \u0915\u0940 \u092A\u094D\u0930\u0924\u093F\u0915\u094D\u0930\u093F\u092F\u093E
      \u0914\u0930 \u092A\u093E\u0920\u094D\u092F\u0915\u094D\u0930\u092E \u0915\u0940
      \u0906\u0935\u0936\u094D\u092F\u0915\u0924\u093E\u0913\u0902 \u0915\u0947 \u0906\u0927\u093E\u0930
      \u092A\u0930 \u0928\u093F\u092F\u092E\u093F\u0924 \u0905\u092A\u0921\u0947\u091F
      \u0915\u0947 \u092E\u093E\u0927\u094D\u092F\u092E \u0938\u0947 \u0928\u090F
      \u0935\u093F\u0937\u092F \u0914\u0930 \u092B\u0940\u091A\u0930\u094D\u0938
      \u091C\u094B\u0921\u093C\u0947 \u091C\u093E\u0924\u0947 \u0930\u0939\u0947\u0902\u0917\u0947\u0964"
    m_Metadata:
      m_Items: []
