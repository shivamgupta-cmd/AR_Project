  m_Script: {fileID: 11500000, guid: 3d893381e1202214b86f97987eddbf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  modelModeManager: {fileID: 2137073922}
  questions:
  - questionText: For a concave mirror, a real inverted magnified image is obtained
      when the object is placed between which two points?
    options:
    - Between P and F
    - Between F and C
    - At C
    - Beyond C
    correctAnswerIndex: 0
    questionVoice: {fileID: 8300000, guid: 1e2c498702d4279449cf84b1a980c137, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 9bcb5e7f6c3433649ac5b9b8cfb365bc, type: 3}
  - questionText: 'A convex mirror always forms what type of image? '
    options:
    - Real and inverted
    - Real and erect
    - Virtual, erect and diminished
    - Virtual and magnified
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: eb292879f4225db4886fb3419e234548, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 6fd224d91e9f1854990d92a0ca3af3fa, type: 3}
  - questionText: In a vehicle, rear-view mirrors are convex because they ____?
    options:
    - Magnify distant objects
    - Provide a wider field of view
    - Produce real images
    - Reduce glare from headlights
    correctAnswerIndex: 1
    questionVoice: {fileID: 8300000, guid: 327a9dcf7a3fce1428b7fb58a2d63a96, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: bcac8262dbaffa3438629fc2104b4169, type: 3}
  - questionText: For a concave mirror, the image cannot be obtained on a screen
      when the object is placed where?
    options:
    - Beyond C
    - At C
    - At F
    - Between F and P
    correctAnswerIndex: 3
    questionVoice: {fileID: 8300000, guid: d6de2b8ba559af746ba3f494d07927e1, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: 871b593f0baf15e409fc182f014a7538, type: 3}
  - questionText: For a convex mirror, the focus lies ______ the mirror?
    options:
    - ' In front of'
    - At the pole of
    - Behind
    - At an infinite distance
    correctAnswerIndex: 2
    questionVoice: {fileID: 8300000, guid: 6096b6ddd19afb0459b235740df9ae38, type: 3}
    correctAnswerVoice: {fileID: 8300000, guid: f0136fcc28db436429c380b71aed6672, type: 3}
